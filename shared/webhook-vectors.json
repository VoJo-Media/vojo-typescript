{
  "description": "Language-neutral webhook verification vectors. Generated from the code that signs real deliveries; do not edit by hand.",
  "scheme": "X-Vojo-Signature: t=<unix seconds>,v1=<lowercase hex HMAC-SHA256 of `${t}.${raw body bytes}`>[,v1=<...>]",
  "default_tolerance_seconds": 300,
  "how_to_use": "For each vector call the verifier with body, header (null = absent), secrets, tolerance_seconds and now (unix seconds). expect.ok true: it returns an event whose type, id and attempt_id equal expect.event. expect.ok false: it raises the error kind named by expect.error. Secrets here are fake.",
  "vectors": [
    {
      "name": "valid_single_signature",
      "description": "One signature, signed with the secret held.",
      "body": "{\"eventType\":\"verification.ping\",\"eventId\":\"evt_ping_0001\",\"attemptId\":\"att_0001\",\"playId\":\"play_0001\",\"organisationId\":\"org_0001\",\"t0\":\"2026-09-21T14:13:20.000Z\",\"events\":[]}",
      "header": "t=1790000000,v1=4dbd2c384e81ff6d4a6a066e56d62d5c307a50b02deb9e2be6155b63782199d7",
      "secrets": [
        "vwsec_11111111111111111111111111111111"
      ],
      "now": 1790000000,
      "tolerance_seconds": 300,
      "expect": {
        "ok": true,
        "event": {
          "type": "verification.ping",
          "id": "evt_ping_0001",
          "attempt_id": "att_0001"
        }
      }
    },
    {
      "name": "valid_snake_case_event",
      "description": "Wrapper events use event_type/event_id; the event is normalised.",
      "body": "{\"event_type\":\"wrapper.ready\",\"event_id\":\"evt_wrapper_0001\",\"attempt_id\":\"att_0002\",\"organisation_id\":\"org_0001\",\"api_version\":\"2026-10-07\",\"created_at\":\"2026-09-21T14:13:20Z\",\"data\":{\"id\":\"wrp_0001\",\"status\":\"ready\"}}",
      "header": "t=1790000000,v1=a4b5583a4f5d8c9c4c45be60ffb0d05000c8ee9afc864b975c4de42498d74cae",
      "secrets": [
